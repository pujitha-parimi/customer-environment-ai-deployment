# Copy to .env for LOCAL (non-Docker) development only. Never commit .env.
# For Docker, secrets live in ./secrets/*.txt (see docs/operational-runbook.md) - NOT in this file.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local dev API auth (comma-separated tokens allowed for rotation overlap)
CUSTOMER_API_TOKENS=change-me-local-dev-token
METRICS_TOKEN=change-me-local-metrics-token

# Optional
LOG_LEVEL=INFO
GEMINI_TIMEOUT_SECONDS=30
ENABLE_DOCS=true
# Docker Compose ports (host side, bound to 127.0.0.1)
APP_PORT=8000
GRAFANA_PORT=3000
# Vault overlay only (local dev-mode Vault; any random string)
# VAULT_DEV_ROOT_TOKEN=
